# Downloaded BodyParts3D archives and their unpacked meshes (~880 MB) — kept in this folder, not in git.
# Re-create with the steps in README.md if needed.
atlas/raw/
atlas/raw_isa/
atlas/obj/
atlas/obj_isa/
atlas/cache/

# Generated build outputs (re-created by `python build.py`)
data/
painmap-3d-offline.html

# Build tool dependencies and temporary generated modules
tools/node_modules/
tools/_*.mjs
__pycache__/

# Release build files are kept locally in !Releases/v<N>/ (large); only notes and checksums are in git.
# The leading backslash stops '!' being read as a negation.
\!Releases/*/*.html
\!Releases/*/body-*.txt
